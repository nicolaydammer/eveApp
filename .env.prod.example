APP_NAME=Laravel
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# URL has to be whatever you want to use for the callback URL in eve application
# if you want example.com then the callback will be example.com/auth/callback
APP_URL=http://localhost

# where the app is located on your system use a full path like /home/user/eveApp
APP_SOURCE_DIR=
# where you want the database data to be stored on your system (full path)
DB_DATA_DIR=
# where you want the redis data to be stored on your system (full path)
REDIS_DATA_DIR=

# port to access the website
# please use a reverse proxy to handle SSL
HOST_HTTP_PORT=8080 

# this is for accessing the services from your system
FORWARD_REDIS_PORT=6379 
FORWARD_DB_PORT=5432
FORWARD_REVERB_PORT=8081

# database settings, please change the password before doing anything
DB_PASSWORD=change_me
DB_DATABASE=laravel
DB_USERNAME=root

# redis password
REDIS_PASSWORD=null

# EVE SSO credentials
EVE_CLIENT_ID=
EVE_CLIENT_SECRET=

# ----- ignore below this line unless you know what you're doing -----
DB_CONNECTION=pgsql
DB_HOST=database
DB_PORT=5432

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379

EVEREF_DB_HOST=
EVEREF_DB_PORT=5432
EVEREF_DB_DATABASE=
EVEREF_DB_USERNAME=
EVEREF_DB_PASSWORD=
EVEREF_HISTORY_MIN_DATE=2016-01-01

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=reverb
REVERB_PORT=
REVERB_SCHEME=

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

VITE_APP_NAME="${APP_NAME}"